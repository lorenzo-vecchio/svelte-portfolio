{
	"name": "svelte-portfolio",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "node scripts/check-data.mjs",
		"build": "vite build",
		"prebuild": "node scripts/refresh-data.mjs && node scripts/check-data.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/check-data.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"projects:sync": "node scripts/sync-projects.mjs",
		"projects:refresh": "node scripts/refresh-data.mjs",
		"generate:og": "node scripts/generate-og.mjs"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.2.8",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@inlang/paraglide-js": "^2.12.0",
		"@lucide/svelte": "^0.561.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^24.0.0",
		"@types/sanitize-html": "^2.16.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-task-lists": "^2.1.1",
		"playwright": "^1.58.2",
		"sanitize-html": "^2.17.0",
		"shiki": "^3.20.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"overrides": {
		"sharp": "0.35.5",
		"vite-imagetools": "12.0.2"
	}
}
